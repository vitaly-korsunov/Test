public int Solution(int[] A)
{
    int n = A.Length;
    int[] left = new int[n];
    int[] right = new int[n];

    // слева направо (как Kadane)
    for (int i = 1; i < n - 1; i++)
    {
        left[i] = Math.Max(0, left[i - 1] + A[i]);
    }

    // справа налево
    for (int i = n - 2; i > 0; i--)
    {
        right[i] = Math.Max(0, right[i + 1] + A[i]);
    }

    int maxSum = 0;

    for (int y = 1; y < n - 1; y++)
    {
        maxSum = Math.Max(maxSum, left[y - 1] + right[y + 1]);
    }

    return maxSum;
}
